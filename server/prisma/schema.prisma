generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ARTISAN
  INTERN
  CUSTOMER
}

enum InternTier {
  STARTER
  GROWTH
  PRO
  EXPERT
}

enum PaymentType {
  FREE
  FIXED
  HOURLY
  STIPEND
}

enum ContractStatus {
  DRAFT
  PROPOSED
  PENDING_ARTISAN
  PENDING_INTERN
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  phone     String   @unique
  password  String
  role      Role     @default(ARTISAN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artisan Artisan?
  intern  Intern?
  cart    Cart?
  orders  Order[]
}

model Artisan {
  id              String @id @default(uuid())
  userId          String @unique
  user            User   @relation(fields: [userId], references: [id])
  location        String
  state           String
  primaryLanguage String
  businessType    String

  products        Product[]
  managerRequests ManagerRequest[]
  projects        Project[]
  contracts       Contract[]
  orderItems      OrderItem[]
}

model Intern {
  id          String     @id @default(uuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id])
  college     String
  course      String
  skills      String[]
  experience  String?
  portfolio   String?
  location    String
  profileImg  String?
  tier        InternTier @default(STARTER)
  hourlyRate  Float?
  projectRate Float?
  isAvailable Boolean    @default(true)
  bio         String?

  applications Application[]
  projects     Project[]
  ratings      Rating[]
  contracts    Contract[]
}

model Product {
  id          String   @id @default(uuid())
  artisanId   String
  artisan     Artisan  @relation(fields: [artisanId], references: [id])
  title       String
  description String
  price       Float
  quantity    Int
  category    String
  tags        String[]
  materials   String[]
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  metric     ProductMetric?
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ManagerRequest {
  id          String        @id @default(uuid())
  artisanId   String
  artisan     Artisan       @relation(fields: [artisanId], references: [id])
  title       String
  description String
  category    String
  budget      String?
  deadline    DateTime?
  status      RequestStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  applications Application[]
  project      Project?
  contracts    Contract[]
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Application {
  id        String            @id @default(uuid())
  requestId String
  request   ManagerRequest    @relation(fields: [requestId], references: [id])
  internId  String
  intern    Intern            @relation(fields: [internId], references: [id])
  message   String
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  project Project?
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Project {
  id             String         @id @default(uuid())
  requestId      String         @unique
  request        ManagerRequest @relation(fields: [requestId], references: [id])
  applicationId  String         @unique
  application    Application    @relation(fields: [applicationId], references: [id])
  artisanId      String
  artisan        Artisan        @relation(fields: [artisanId], references: [id])
  internId       String
  intern         Intern         @relation(fields: [internId], references: [id])
  status         ProjectStatus  @default(IN_PROGRESS)
  startDate      DateTime       @default(now())
  completionDate DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  messages Message[]
  rating   Rating?
  contract Contract?
}

model Contract {
  id               String         @id @default(uuid())
  projectId        String?        @unique
  project          Project?       @relation(fields: [projectId], references: [id])
  requestId        String?
  request          ManagerRequest? @relation(fields: [requestId], references: [id])
  artisanId        String
  artisan          Artisan        @relation(fields: [artisanId], references: [id])
  internId         String
  intern           Intern         @relation(fields: [internId], references: [id])
  tier             InternTier     @default(STARTER)
  title            String
  description      String?
  startDate        DateTime       @default(now())
  endDate          DateTime?
  duration         String?
  paymentType      PaymentType    @default(FIXED)
  paymentAmount    Float          @default(0)
  responsibilities String[]
  status           ContractStatus @default(PROPOSED)
  artisanAgreed    Boolean        @default(false)
  internAgreed     Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tasks ContractTask[]
}

model ContractTask {
  id           String    @id @default(uuid())
  contractId   String
  contract     Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  assignedRole String?
  isCompleted  Boolean   @default(false)
  status       String    @default("TODO")
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String        @id @default(uuid())
  customerId      String
  customer        User          @relation(fields: [customerId], references: [id])
  totalAmount     Float
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  shippingAddress String
  phone           String
  customerName    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  artisanId String
  artisan   Artisan  @relation(fields: [artisanId], references: [id])
  title     String
  price     Float
  quantity  Int
}

model ProductMetric {
  id            String   @id @default(uuid())
  productId     String   @unique
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  views         Int      @default(0)
  favorites     Int      @default(0)
  cartAdditions Int      @default(0)
  orders        Int      @default(0)
  revenue       Float    @default(0)
  updatedAt     DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String
  userId    String?
  productId String?
  metadata  String?
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  senderId  String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Rating {
  id        String   @id @default(uuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id])
  internId  String
  intern    Intern   @relation(fields: [internId], references: [id])
  score     Int
  review    String?
  createdAt DateTime @default(now())
}
